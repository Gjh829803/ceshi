*.patch text eol=lf
*.sh text eol=lf
*.mjs text eol=lf
# Catalog resources are content-addressed, including JSON clips and notices.
# Preserve exact bytes on add/checkout, independent of core.autocrlf.
assets/three-creator/presets/** -text
.codex/skills/*/scripts/self-check.mjs -whitespace
.codex/skills/*/scripts/render-visual-review.mjs -whitespace

# Camera discovery verifies exact source bytes against its generated inventory.
packages/three-world/src/config/camera/*.ts text eol=lf
packages/three-world/src/control-support.ts text eol=lf

# The generated catalog is verified byte-for-byte against canonical JSON.
assets/three-creator/asset-catalog.json text eol=lf
