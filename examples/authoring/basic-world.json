{
  "kind": "worldkit-authoring-spec",
  "schemaVersion": 2,
  "id": "basic-world",
  "seed": 1024,
  "provenance": {
    "userPrompt": "Create a playable outdoor whitebox with rolling ground, a lake, a tower, and two corridor walls."
  },
  "world": {
    "coordinateSystem": "right-handed-y-up-minus-z-forward",
    "bounds": {
      "centerMetersXZ": [0, 0],
      "sizeMetersXZ": [120, 120],
      "heightRangeMeters": [-8, 16]
    },
    "gravityMetersPerSecondSquaredXYZ": [0, -9.81, 0],
    "environment": {
      "preset": "clear-day"
    },
    "resourceBudget": {
      "maxVertices": 20000,
      "maxTriangles": 30000,
      "maxColliders": 16
    }
  },
  "resources": {
    "prototypes": [
      {
        "id": "corridor-wall",
        "version": 1,
        "kind": "primitive",
        "primitive": "box",
        "sizeMetersXYZ": [2, 3, 24],
        "collisionEnabled": true,
        "semantic": {
          "classId": "obstacle.wall"
        }
      },
      {
        "id": "landmark-tower",
        "version": 1,
        "kind": "primitive",
        "primitive": "cylinder",
        "radiusMeters": 2.5,
        "heightMeters": 10,
        "collisionEnabled": true,
        "semantic": {
          "classId": "landmark.tower"
        }
      }
    ],
    "subjectDefinitions": []
  },
  "nodes": [
    {
      "id": "terrain-main",
      "kind": "terrain",
      "components": {
        "terrain": {
          "source": {
            "kind": "procedural",
            "relief": "plain",
            "amplitudeMeters": 1.5
          },
          "grid": {
            "centerMetersXZ": [0, 0],
            "sizeMetersXZ": [120, 120],
            "resolutionCellsXZ": [65, 65]
          },
          "semantic": {
            "classId": "terrain.grassland"
          }
        }
      }
    },
    {
      "id": "lake-main",
      "kind": "water",
      "components": {
        "water": {
          "terrainEntityId": "terrain-main",
          "boundary": {
            "kind": "ellipse",
            "centerMetersXZ": [0, -12],
            "radiusMetersXZ": [13, 17]
          },
          "depthMeters": 4,
          "shoreWidthMeters": 3,
          "waterLevelMeters": 1.5,
          "traversalMode": "swimmable",
          "semantic": {
            "classId": "water.lake"
          }
        }
      }
    },
    {
      "id": "tower",
      "kind": "object",
      "prototypeRef": "package://prototype/landmark-tower@1",
      "transform": {
        "positionMetersXYZ": [17, 5, -19]
      }
    },
    {
      "id": "wall-east",
      "kind": "object",
      "prototypeRef": "package://prototype/corridor-wall@1",
      "transform": {
        "positionMetersXYZ": [7, 1.5, 22]
      }
    },
    {
      "id": "wall-west",
      "kind": "object",
      "prototypeRef": "package://prototype/corridor-wall@1",
      "transform": {
        "positionMetersXYZ": [-7, 1.5, 22]
      }
    },
    {
      "id": "spawn-main",
      "kind": "anchor",
      "transform": {
        "positionMetersXYZ": [0, 0, 30]
      },
      "semantic": {
        "classId": "spawn.player"
      }
    },
    {
      "id": "player",
      "kind": "subject",
      "subjectDefinitionRef": "worldkit://subject-definition/humanoid.third-person@1",
      "spawnAnchorEntityId": "spawn-main"
    },
    {
      "id": "camera-main",
      "kind": "camera",
      "components": {
        "cameraRig": {
          "defaultRigRef": "worldkit://camera/third-person.standard@1",
          "allowedRigRefs": [
            "worldkit://camera/third-person.standard@1"
          ],
          "target": {
            "targetEntityId": "player",
            "targetHeightMeters": 1.2
          },
          "thirdPerson": {
            "pitchRadians": 0.22,
            "distanceMeters": 6,
            "targetHeightMeters": 1.2,
            "fovDegrees": 58
          },
          "manualSwitchAllowed": false
        }
      }
    }
  ],
  "relationships": [],
  "rules": [],
  "startup": {
    "spawnAnchorEntityId": "spawn-main",
    "controlledEntityId": "player",
    "cameraEntityId": "camera-main"
  },
  "constraints": {}
}
