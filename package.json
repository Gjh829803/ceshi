{
  "name": "agent-whitebox-world-sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Three.js world creation, SDK runtime and Episode data production.",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "pnpm --filter @whitebox-world/playground dev",
    "dev:native-scene": "pnpm --filter @whitebox-world/native-scene-playground dev",
    "dev:g-bot": "pnpm worldkit run examples/authoring/g-bot-subject-world.json",
    "dev:g-bot:refresh": "pnpm worldkit run examples/authoring/g-bot-subject-world.json --refresh-dependencies",
    "generate:golden-humanoid": "tsx scripts/fixtures/generate-golden-humanoid-glb.ts --write",
    "assets:subjects:modularize": "tsx scripts/assets/modular-subject-source-packages.ts --write",
    "assets:subjects:modularize:check": "tsx scripts/assets/modular-subject-source-packages.ts --check",
    "assets:subjects:runtime-bundles": "tsx scripts/assets/modular-subject-runtime-bundles.ts --write",
    "assets:subjects:runtime-bundles:check": "tsx scripts/assets/modular-subject-runtime-bundles.ts --check",
    "verify:xier120-subjects": "tsx scripts/verification/verify-xier120-subjects.ts",
    "generate:example-takes": "tsx scripts/examples/generate-example-takes.ts",
    "studio": "pnpm --filter @whitebox-world/studio dev",
    "studio:public": "pnpm --filter @whitebox-world/studio public",
    "studio:seedance-public": "pnpm --filter @whitebox-world/studio seedance-public-proxy",
    "terrain:intent:compile": "tsx packages/terrain-compiler/src/cli/main.ts",
    "test:studio": "pnpm --filter @whitebox-world/studio test",
    "test:independent": "tsx scripts/testing/run-independent-test-gate.ts",
    "test:independent:node": "tsx scripts/testing/run-independent-test-gate.ts --lane node",
    "test:independent:site": "tsx scripts/testing/run-independent-test-gate.ts --lane site",
    "build": "pnpm --filter @whitebox-world/playground build",
    "build:native-scene": "pnpm --filter @whitebox-world/native-scene-playground build",
    "generate:agent-self-check": "node scripts/agents/build-agent-self-check.mjs",
    "check:agent-self-check": "tsx scripts/agents/check-agent-self-check.ts",
    "agent:world": "LC_ALL=C LANG=C bash scripts/agents/run-spatial-world-agent.sh",
    "agent:world:whitebox": "LC_ALL=C LANG=C bash scripts/agents/run-spatial-world-agent.sh --whitebox-only",
    "agent:world:preview": "tsx scripts/agents/agent-runtime-preview.ts",
    "agent:world:plan": "LC_ALL=C LANG=C bash scripts/agents/run-spatial-world-agent.sh --plan-only",
    "agent:world:build": "LC_ALL=C LANG=C bash scripts/agents/run-spatial-world-agent.sh --build-only",
    "agent:world:resume-host": "LC_ALL=C LANG=C bash scripts/agents/run-spatial-world-agent.sh --resume-host-only",
    "agent:world:visual-reconstruct": "LC_ALL=C LANG=C bash scripts/agents/run-lwdp-visual-reconstruction-agent.sh",
    "episode:run": "node scripts/episodes/run-episode-workflow.mjs",
    "episode:validate-plan": "node scripts/episodes/validate-playthrough-plan.mjs",
    "verify:runtime-config": "node scripts/verification/verify-project-runtime-credentials.mjs",
    "agent:world:first-frame": "LC_ALL=C LANG=C bash scripts/visual/run-styled-opening-frame-agent.sh",
    "agent:world:styled-triviews": "LC_ALL=C LANG=C bash scripts/visual/run-styled-triviews-agent.sh",
    "agent:world:video-prompt": "LC_ALL=C LANG=C bash scripts/visual/run-visual-reconstruction-agent.sh",
    "cloud:scene:submit": "node scripts/cloud/submit-worldkit-cloud-scene.mjs",
    "cloud:scene:worker": "node scripts/cloud/run-worldkit-cloud-scene-worker.mjs",
    "cloud:scene:launch-worker": "node scripts/cloud/launch-worldkit-cloud-worker-job.mjs",
    "cloud:scene:batch": "node scripts/cloud/run-worldkit-cloud-scene-batch.mjs",
    "cloud:scene:monitor": "node scripts/cloud/monitor-worldkit-cloud-scene-batch.mjs",
    "cloud:episode:submit": "node scripts/cloud/submit-worldkit-cloud-episode.mjs",
    "cloud:episode:worker": "node scripts/cloud/run-worldkit-cloud-episode-worker.mjs",
    "cloud:episode:launch-worker": "node scripts/cloud/launch-worldkit-cloud-episode-worker-job.mjs",
    "cloud:episode:gpu-dispatch": "node scripts/cloud/dispatch-worldkit-gpu-capture-batch.mjs",
    "cloud:episode:gpu-batch-worker": "node scripts/cloud/run-worldkit-cloud-gpu-capture-batch-worker.mjs",
    "cloud:episode:launch-gpu-batch": "node scripts/cloud/launch-worldkit-cloud-gpu-capture-batch-job.mjs",
    "cloud:episode:deploy-gpu-dispatcher": "node scripts/cloud/launch-worldkit-gpu-batch-dispatcher-cronjob.mjs",
    "cloud:control-plane:deploy": "node scripts/cloud/launch-worldkit-cloud-control-plane.mjs",
    "cloud:episode:apply-runtime-secret": "node scripts/cloud/apply-worldkit-episode-runtime-secret.mjs",
    "test:cloud-orchestration": "node --test scripts/agents/lwdp-cloud-execution-client.test.mjs scripts/cloud/*.test.mjs",
    "plan:freeze": "tsx scripts/scenes/freeze-world-plan.ts",
    "plan:check": "tsx scripts/scenes/freeze-world-plan.ts --check",
    "plan:scene": "tsx scripts/scenes/export-scene-plan.ts",
    "plan:scene:check": "tsx scripts/scenes/export-scene-plan.ts --check",
    "visual:inputs": "tsx scripts/visual/validate-visual-package.ts --mode inputs",
    "visual:finalize": "tsx scripts/visual/validate-visual-package.ts --mode complete",
    "visual:check": "tsx scripts/visual/validate-visual-package.ts --mode complete --check",
    "test:isolation": "LC_ALL=C LANG=C bash scripts/testing/verify-workspace-isolation.sh",
    "import:local-humanoid": "bash scripts/assets/link-local-humanoid.sh",
    "link:local-humanoid": "bash scripts/assets/link-local-humanoid.sh",
    "typecheck": "tsc --noEmit",
    "test": "pnpm verify:workspace-boundaries && pnpm test:census && pnpm test:contract && pnpm test:resource-heavy",
    "test:census": "tsx scripts/testing/verify-test-gate-census.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:contract:coverage": "vitest run --coverage --config vitest.contract.config.ts --coverage.reporter=text --coverage.reporter=json-summary",
    "test:resource-heavy": "vitest run --config vitest.resource-heavy.config.ts",
    "test:focused": "vitest run",
    "test:scenes": "vitest run packages/world/src/scene.test.ts apps/playground/src/scenes/scenes.test.ts",
    "test:watch": "vitest",
    "block-world:check": "tsx scripts/cli/check-block-world.ts",
    "block-world:compile": "tsx scripts/cli/compile-block-world.ts",
    "worldkit": "tsx scripts/cli/worldkit.ts",
    "subject-preset": "tsx scripts/cli/worldkit.ts subject-preset",
    "verify:canonical": "tsx scripts/verification/verify-canonical-world.ts",
    "verify:canonical:update": "tsx scripts/verification/verify-canonical-world.ts --update",
    "verify:placement-layout": "tsx scripts/verification/verify-placement-layout.ts",
    "verify:placement-layout:update": "tsx scripts/verification/verify-placement-layout.ts --update",
    "verify:rigged-subject": "tsx scripts/verification/verify-rigged-subject-world.ts",
    "verify:rigged-subject:update": "tsx scripts/verification/verify-rigged-subject-world.ts --update",
    "verify:g-bot-subject": "tsx scripts/verification/verify-g-bot-subject-world.ts",
    "verify:g-bot-subject:update": "tsx scripts/verification/verify-g-bot-subject-world.ts --update",
    "verify:control-capture": "tsx scripts/verification/verify-control-capture.ts",
    "verify:validation-capture": "tsx scripts/verification/verify-validation-capture.ts",
    "verify:route-r0-contract": "tsx scripts/verification/verify-route-r0-contract.ts",
    "verify:route-r1-heightfield": "tsx scripts/verification/verify-route-r1-heightfield.ts",
    "verify:route-r1b-static-platform": "tsx scripts/verification/verify-route-r1b-static-platform.ts",
    "verify:outdoor-gameplay": "tsx scripts/verification/verify-outdoor-gameplay-worlds.ts",
    "verify:native-scene-playground": "tsx scripts/verification/verify-native-scene-playground.ts",
    "verify:unreleased-clean-break": "tsx scripts/verification/verify-unreleased-clean-break.ts",
    "verify:bna1-clean-break": "tsx scripts/verification/verify-bna1-clean-break.ts",
    "verify:3c-migration": "tsx scripts/verification/verify-3c-migration.ts",
    "verify:workspace-boundaries": "tsx scripts/testing/verify-workspace-boundaries.ts",
    "benchmark:route-r1b-surface-preflight": "tsx scripts/verification/benchmark-route-r1b-surface-preflight.ts",
    "cloud:episode:three-batch": "node scripts/three-episode/batch-cli.mjs",
    "cloud:episode:three-batch-infrastructure": "node scripts/cloud/three-episode-batch-infrastructure.mjs",
    "three:creator": "tsx scripts/three-creator/cli.ts",
    "three:creator:prebuild": "tsx scripts/three-creator/prebuild.ts",
    "three:episode:source": "tsx scripts/three-episode/source.ts",
    "three:episode:run": "tsx scripts/three-episode/workflow.ts",
    "three:episode:batch": "node scripts/three-episode/batch-cli.mjs",
    "three:episode:resume": "tsx scripts/three-episode/resume.ts",
    "three:episode:preview": "node scripts/three-episode/preview-server.mjs"
  },
  "dependencies": {
    "@worldkit/three": "workspace:*",
    "@babylonjs/core": "9.23.0",
    "@babylonjs/havok": "1.3.14",
    "@whitebox-world/authoring": "workspace:*",
    "@whitebox-world/authoring-edit": "workspace:*",
    "@whitebox-world/authoring-host": "workspace:*",
    "@whitebox-world/block-world": "workspace:*",
    "@whitebox-world/block-world-compiler": "workspace:*",
    "@whitebox-world/block-world-three": "workspace:*",
    "@whitebox-world/compiler": "workspace:*",
    "@whitebox-world/control-capture": "workspace:*",
    "@whitebox-world/gameplay": "workspace:*",
    "@whitebox-world/gameplay-contracts": "workspace:*",
    "@whitebox-world/native-babylon": "workspace:*",
    "@whitebox-world/protocol": "workspace:*",
    "@whitebox-world/runtime-babylon": "workspace:*",
    "@whitebox-world/runtime-contracts": "workspace:*",
    "@whitebox-world/runtime-host": "workspace:*",
    "@whitebox-world/scene-authoring-contracts": "workspace:*",
    "@whitebox-world/subject-contracts": "workspace:*",
    "@whitebox-world/subject-registry": "workspace:*",
    "@whitebox-world/terrain-compiler": "workspace:*",
    "@whitebox-world/terrain-surface": "workspace:*",
    "@whitebox-world/traversal": "workspace:*",
    "@whitebox-world/traversal-recast": "workspace:*",
    "@whitebox-world/validation": "workspace:*",
    "@whitebox-world/world": "workspace:*",
    "@whitebox-world/world-identity": "workspace:*",
    "@whitebox-world/world-package": "workspace:*",
    "lodash-es": "^4.18.1",
    "sharp": "0.35.4",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/three": "0.185.4",
    "esbuild": "0.28.2",
    "@gltf-transform/core": "4.4.2",
    "@gltf-transform/functions": "4.4.2",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "ajv": "8.17.1",
    "gltf-validator": "2.0.0-dev.3.10",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
