{
  "name": "agent-whitebox-world-sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Three.js world creation, SDK runtime and Episode data production.",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "tsx scripts/three-creator/training-preview.ts",
    "dev:training": "tsx scripts/three-creator/training-preview.ts",
    "test:training:browser": "tsx scripts/three-creator/training-browser-smoke.ts",
    "test:training:camera": "tsx scripts/three-creator/training-camera-browser-smoke.ts",
    "test:training:camera:visibility": "tsx scripts/three-creator/training-camera-visibility-browser.ts",
    "test:training:inspector": "tsx scripts/three-creator/training-inspector-browser-smoke.ts",
    "test:training:delivery": "tsx scripts/three-creator/training-delivery-smoke.ts",
    "test:training:flow": "tsx scripts/three-creator/training-flow-acceptance.ts",
    "build": "pnpm three:creator:prebuild --profile three-sdk --output .codex-tmp/three-runtime",
    "test:independent": "tsx scripts/testing/run-independent-test-gate.ts",
    "test:independent:node": "tsx scripts/testing/run-independent-test-gate.ts --lane node",
    "typecheck": "tsc --noEmit",
    "test": "pnpm verify:workspace-boundaries && pnpm test:census && pnpm test:contract && pnpm test:resource-heavy",
    "test:census": "tsx scripts/testing/verify-test-gate-census.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:contract:coverage": "vitest run --coverage --config vitest.contract.config.ts --coverage.reporter=text --coverage.reporter=json-summary",
    "test:resource-heavy": "vitest run --config vitest.resource-heavy.config.ts",
    "test:focused": "vitest run",
    "test:watch": "vitest",
    "verify:workspace-boundaries": "pnpm verify:three-workspace && tsx scripts/testing/verify-workspace-boundaries.ts",
    "cloud:episode:three-batch": "node scripts/three-episode/batch-cli.mjs",
    "cloud:episode:three-batch-infrastructure": "node scripts/cloud/three-episode-batch-infrastructure.mjs",
    "three:creator": "tsx scripts/three-creator/cli.ts",
    "three:creator:prebuild": "tsx scripts/three-creator/prebuild.ts",
    "three:episode:source": "tsx scripts/three-episode/source.ts",
    "three:episode:run": "tsx scripts/three-episode/workflow.ts",
    "three:episode:batch": "node scripts/three-episode/batch-cli.mjs",
    "three:episode:resume": "tsx scripts/three-episode/resume.ts",
    "three:episode:preview": "node scripts/three-episode/preview-server.mjs",
    "verify:three-workspace": "tsx scripts/testing/verify-three-workspace.ts",
    "test:cloud-orchestration": "node --test scripts/cloud/*.test.mjs",
    "dev:editor": "pnpm --filter @worldkit/three-playground dev",
    "build:editor": "pnpm --filter @worldkit/three-playground build",
    "test:editor:browser": "tsx apps/three-playground/scripts/browser-smoke.ts"
  },
  "dependencies": {
    "@worldkit/three": "workspace:*",
    "lodash-es": "^4.18.1",
    "sharp": "0.35.4",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/three": "0.185.4",
    "esbuild": "0.28.2",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "ajv": "8.17.1",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
