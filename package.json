{
  "name": "agent-whitebox-world-sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Three.js world creation, SDK runtime and Episode data production.",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "pnpm dev:editor",
    "dev:example": "tsx packages/creator-host/src/cli/example-preview.ts",
    "test:humanoid:camera": "tsx packages/creator-host/scripts/smoke/humanoid-camera-browser-smoke.ts",
    "test:humanoid:camera:visibility": "tsx packages/creator-host/scripts/smoke/humanoid-camera-visibility-browser.ts",
    "test:preset:delivery": "tsx scripts/integration/preset-delivery-smoke.ts",
    "test:preset:flow": "tsx scripts/integration/preset-flow-acceptance.ts",
    "build": "pnpm three:creator:prebuild --profile three-sdk --output .codex-tmp/three-runtime",
    "test:independent": "tsx scripts/testing/run-independent-test-gate.ts",
    "test:independent:node": "tsx scripts/testing/run-independent-test-gate.ts --lane node",
    "typecheck": "tsc --noEmit && pnpm --filter @worldkit/asset-platform typecheck",
    "test": "pnpm verify:workspace-boundaries && pnpm test:census && pnpm test:contract && pnpm test:resource-heavy",
    "test:census": "tsx scripts/testing/verify-test-gate-census.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:contract:coverage": "vitest run --coverage --config vitest.contract.config.ts --coverage.reporter=text --coverage.reporter=json-summary",
    "test:resource-heavy": "vitest run --config vitest.resource-heavy.config.ts",
    "test:camera:editor": "tsx apps/sdk-playground/scripts/camera-quality/editor.ts",
    "test:camera:browser": "tsx apps/sdk-playground/scripts/camera-quality/run.ts",
    "test:camera": "vitest run --config scripts/testing/camera.vitest.config.ts",
    "test:focused": "vitest run",
    "test:watch": "vitest",
    "verify:workspace-boundaries": "pnpm verify:three-workspace && tsx scripts/testing/verify-workspace-boundaries.ts",
    "cloud:episode:three-batch": "node packages/episode-pipeline/src/cli/batch-cli.mjs",
    "cloud:episode:three-batch-infrastructure": "node packages/episode-pipeline/src/cloud/cloud-batch-infrastructure.mjs",
    "three:creator": "tsx packages/creator-host/src/cli/cli.ts",
    "three:creator:prebuild": "tsx packages/creator-host/src/cli/prebuild.ts",
    "three:episode:source": "tsx packages/episode-pipeline/src/source/source.ts",
    "three:episode:run": "tsx packages/episode-pipeline/src/workflow/workflow.ts",
    "three:episode:batch": "node packages/episode-pipeline/src/cli/batch-cli.mjs",
    "three:episode:resume": "tsx packages/episode-pipeline/src/workflow/resume.ts",
    "three:episode:preview": "node packages/episode-pipeline/src/cli/preview-server.mjs",
    "verify:three-workspace": "tsx scripts/testing/verify-three-workspace.ts",
    "test:cloud-orchestration": "node --test apps/creator-cloud/*.test.mjs",
    "dev:editor": "pnpm --filter @worldkit/sdk-playground dev",
    "prepare:dragon-training": "tsx apps/sdk-playground/scripts/prepare-dragon-training.ts",
    "verify:dragon-training": "tsx apps/sdk-playground/scripts/dragon-training-smoke.ts",
    "build:editor": "pnpm --filter @worldkit/sdk-playground build",
    "test:editor:browser": "tsx apps/sdk-playground/scripts/browser-smoke.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "assets:publish": "node scripts/assets/sync-asset-contracts.mjs && node scripts/assets/sync-asset-client.mjs && node asset-library/tools/serve.mjs --publish --prepare-only",
    "assets:serve": "pnpm --filter @worldkit/asset-platform dev",
    "assets:cli": "node packages/asset-client/src/cli.mjs",
    "assets:check": "node scripts/assets/sync-asset-contracts.mjs --check && node scripts/assets/sync-asset-client.mjs --check && node --test asset-library/tests/*.test.mjs packages/asset-contracts/tests/*.test.mjs packages/asset-client/tests/*.test.mjs",
    "content:sync": "tsx packages/creator-host/src/cli/content-cli.ts",
    "content:check": "tsx packages/creator-host/src/cli/content-cli.ts --check",
    "build:stream-web": "pnpm --filter @worldkit/stream-web build",
    "dev:stream": "pnpm build:stream-web && pnpm --filter @worldkit/stream-host exec tsx src/cli.ts --worlds ../../examples/worlds --web-root ../../apps/stream-web/dist",
    "dev:assets": "pnpm --filter @worldkit/asset-platform dev",
    "build:assets": "pnpm --filter @worldkit/asset-platform build"
  },
  "dependencies": {
    "@worldkit/browser-capture": "workspace:*",
    "@worldkit/creator-host": "workspace:*",
    "@worldkit/episode-pipeline": "workspace:*",
    "@worldkit/preset-content": "workspace:*",
    "@worldkit/three": "workspace:*",
    "@worldkit/world-ui": "workspace:*",
    "lodash-es": "^4.18.1",
    "sharp": "0.35.4",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.3.0",
    "@types/three": "0.185.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@worldkit/creator-cloud": "workspace:*",
    "ajv": "8.17.1",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "lucide-react": "1.42.0",
    "playwright": "^1.62.1",
    "shadcn": "^4.21.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.70.0",
    "vitest": "^3.2.4",
    "next": "16.3.5",
    "@tailwindcss/postcss": "4.3.3"
  }
}
