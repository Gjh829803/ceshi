{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "shapes": {
      "type": "array",
      "items": {
        "$ref": "urn:worldkit:content-parameters:1#/$defs/box"
      }
    },
    "verification": {
      "enum": [
