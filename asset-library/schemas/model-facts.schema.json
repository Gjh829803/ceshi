{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "socket_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "roadCushion": {
      "type": "object",
      "properties": {
        "center": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "size": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      },
      "required": [
        "center",
        "size"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Model geometry and referenced sockets"
}
