{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "validation",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "structure": {
      "type": "string",
      "enum": [
        "pending",
        "passed",
        "failed"
      ]
    },
    "format": {
      "type": "string",
      "enum": [
        "pending",
        "passed",
        "failed",
        "not_applicable",
        "fbx_source_unvalidated"
      ]
    },
    "visual": {
      "type": "string",
      "enum": [
        "not_run",
        "preview_loaded",
        "verified"
      ]
    },
    "runtime": {
      "$ref": "urn:worldkit:asset-contracts:1.0.0#/$defs/RuntimeValidation/properties/runtime"
    },
    "checked_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "$ref": "urn:worldkit:asset-contracts:1.0.0#/$defs/RuntimeValidation/properties/evidence"
    }
  },
  "required": [
    "schema_version",
    "structure",
    "format",
    "visual",
    "runtime",
    "checked_at",
    "evidence"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "$ref": "urn:worldkit:asset-contracts:1.0.0#/$defs/RuntimeValidation"
    }
  ]
}
