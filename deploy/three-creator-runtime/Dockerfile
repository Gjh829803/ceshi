# Build only with the credential-free context generated by three-capsule.mjs.
# Never use a repository root as this Dockerfile's build context.
FROM node:20.20.2-bookworm-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0 AS dependencies
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV CI=true PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 TSX_DISABLE_CACHE=1
WORKDIR /opt/three-creator-toolkit/sdk
RUN test "$(node --version)" = "v20.20.2" \
    && test "$(node -p process.arch)" = "x64" \
    && npm install --global pnpm@10.14.0 --ignore-scripts --no-audit --no-fund
COPY manifests/ ./
RUN pnpm install --frozen-lockfile --reporter=append-only
COPY doctor.mjs /tmp/three-creator-doctor.mjs
COPY three-capsule.mjs /tmp/three-capsule.mjs
RUN mkdir -p /opt/three-creator-toolkit/runtime/bin \
    && cp /usr/local/bin/node /opt/three-creator-toolkit/runtime/bin/node \
    && cp /usr/local/LICENSE /opt/three-creator-toolkit/runtime/NODE-LICENSE \
    && node /tmp/three-creator-doctor.mjs --dependencies --capsule-root /opt/three-creator-toolkit \
    && node --input-type=module -e 'import {auditCapsule} from "/tmp/three-capsule.mjs"; import {writeFileSync} from "node:fs"; const audit=auditCapsule("/opt/three-creator-toolkit"); writeFileSync("/opt/three-creator-toolkit/dependency-audit.json",JSON.stringify(audit,null,2)+"\n"); console.log(JSON.stringify({dependencyFileCount:audit.entries.length,elfCount:audit.elfCount,maximumRequiredGlibc:audit.maximumRequiredGlibc,relocatedShimCount:audit.relocatedShimCount}));'

FROM scratch AS dependency-report
COPY --from=dependencies /opt/three-creator-toolkit/dependency-doctor.json /dependency-doctor.json
COPY --from=dependencies /opt/three-creator-toolkit/dependency-audit.json /dependency-audit.json

FROM dependencies AS toolkit-build
COPY sources/ ./
COPY three-capsule.mjs /tmp/three-capsule.mjs
ARG EXPECTED_SOURCE_HASH
RUN mkdir -p /opt/three-creator-toolkit/runtime/bin /export \
    && cp /usr/local/bin/node /opt/three-creator-toolkit/runtime/bin/node \
    && cp /usr/local/LICENSE /opt/three-creator-toolkit/runtime/NODE-LICENSE \
    && node /tmp/three-capsule.mjs --inside-container \
      --capsule-root /opt/three-creator-toolkit --expected-source-hash "${EXPECTED_SOURCE_HASH}" \
    && tar --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner \
      --transform='s,^three-creator-toolkit,toolkit,' -cf - -C /opt three-creator-toolkit \
      | gzip -n > /export/three-creator-toolkit.tar.gz

FROM scratch AS capsule
COPY --from=toolkit-build /opt/three-creator-toolkit /toolkit
COPY --from=toolkit-build /export/three-creator-toolkit.tar.gz /three-creator-toolkit.tar.gz
