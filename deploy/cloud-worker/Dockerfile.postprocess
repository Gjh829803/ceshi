FROM 829115578968.dkr.ecr.us-east-2.amazonaws.com/worldkit-cloud-worker@sha256:f267bb928a2b11f1164d2a1c83a44687e25b0a119f4baec9477a789c3045a420 AS toolchain

# Reuse the already admitted Node/Python/ffmpeg toolchain without inheriting
# the Playwright base layers or copying /ms-playwright (about 1.3 GiB).
FROM debian:bookworm-slim

ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:/usr/local/bin:/usr/bin:/bin

COPY --from=toolchain /usr /usr
COPY --from=toolchain /lib /lib
COPY --from=toolchain /pnpm /pnpm
COPY --from=toolchain /etc/ssl/certs /etc/ssl/certs
COPY --from=toolchain /etc/alternatives /etc/alternatives

WORKDIR /workspace/worldkit
# The admitted toolchain already contains the lockfile-resolved pnpm store and
# workspace links. Overlay only current source; package dependencies did not
# change, so the build does not need network package installation.
COPY --from=toolchain /workspace/worldkit /workspace/worldkit
COPY . .

RUN node --version \
    && python3 --version \
    && ffmpeg -version >/dev/null \
    && aws --version \
    && zip -v | head -2

ARG WORLDKIT_SOURCE_REVISION=unknown
ENV WORLDKIT_SOURCE_REVISION=$WORLDKIT_SOURCE_REVISION

ENTRYPOINT ["node", "scripts/cloud/run-worldkit-cloud-episode-worker.mjs"]
