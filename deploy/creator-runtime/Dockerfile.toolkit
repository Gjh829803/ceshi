# The build context is produced by prepare-creator-toolkit-capsule.mjs.
# Never build this file against the repository root or forward credentials.
ARG NODE_SOURCE_IMAGE=node:20.20.2-bookworm-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0
FROM ${NODE_SOURCE_IMAGE} AS toolkit-build
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG NODE_SOURCE_IMAGE
ENV CI=true PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
WORKDIR /opt/worldkit-toolkit/sdk
RUN test "$(node --version)" = "v20.20.2" \
    && npm install --global pnpm@10.14.0 --ignore-scripts --no-audit --no-fund

# Source edits do not invalidate the dependency installation layer.
COPY manifests/ ./
RUN pnpm install --frozen-lockfile --reporter=append-only
COPY sources/ ./
COPY prepare-creator-toolkit-capsule.mjs /tmp/prepare-creator-toolkit-capsule.mjs
ARG SKIP_COMPILE_DOCTOR=0
RUN mkdir -p /opt/worldkit-toolkit/runtime/bin /export \
    && cp /usr/local/bin/node /opt/worldkit-toolkit/runtime/bin/node \
    && cp /usr/local/LICENSE /opt/worldkit-toolkit/runtime/NODE-LICENSE \
    && node /tmp/prepare-creator-toolkit-capsule.mjs \
      --inside-container --capsule-root /opt/worldkit-toolkit \
      --source-image "${NODE_SOURCE_IMAGE}" \
      $([ "${SKIP_COMPILE_DOCTOR}" = "1" ] && printf '%s' --skip-compile-doctor || true) \
    && tar --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner \
      --transform='s,^worldkit-toolkit,toolkit,' -cf - -C /opt worldkit-toolkit \
      | gzip -n > /export/creator-toolkit.tar.gz

FROM scratch AS capsule
COPY --from=toolkit-build /opt/worldkit-toolkit /toolkit
COPY --from=toolkit-build /export/creator-toolkit.tar.gz /creator-toolkit.tar.gz
