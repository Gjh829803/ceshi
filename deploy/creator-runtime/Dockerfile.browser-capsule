# This stage is an extraction source, not the cloud Creator image. Pin the
# amd64 Jammy image so libc dependencies never come from a Noble container.
ARG PLAYWRIGHT_SOURCE_IMAGE=mcr.microsoft.com/playwright@sha256:75d2d72c89da49d06aa7f6e623987392019aebbc52c09fd8cd6e2c94c7c7d71d
ARG CACHED_BROWSER_IMAGE=worldkit-browser-source-gpt6-capsule:local
FROM ${PLAYWRIGHT_SOURCE_IMAGE} AS capsule-source

ARG PLAYWRIGHT_SOURCE_IMAGE
USER root
COPY scripts/cloud/prepare-creator-browser-capsule.mjs /tmp/prepare-creator-browser-capsule.mjs
RUN node /tmp/prepare-creator-browser-capsule.mjs \
    --extract-in-container \
    --source-image "${PLAYWRIGHT_SOURCE_IMAGE}" \
    --output-dir /export/browser-capsule

FROM scratch AS capsule
COPY --from=capsule-source /export/browser-capsule /browser-capsule

# Fast alternative when the large official Jammy image is not locally cached.
# Only the same Linux x64 CfT browser and a build-time Node executable come
# from the cached image. Every exported system library comes from Jammy apt.
FROM ${CACHED_BROWSER_IMAGE} AS cached-browser
FROM ubuntu@sha256:2edbbc5dc405e9612ba3584ce95480277e3eb374407b5505fe26f17df77c7dbc AS jammy-source
ARG CACHED_BROWSER_IMAGE_ID
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
    libasound2 libatk-bridge2.0-0 libatk1.0-0 libatspi2.0-0 libcairo2 \
    libcups2 libdbus-1-3 libdrm2 libgbm1 libglib2.0-0 libnspr4 libnss3 \
    libpango-1.0-0 libwayland-client0 libx11-6 libxcb1 libxcomposite1 \
    libxdamage1 libxext6 libxfixes3 libxkbcommon0 libxrandr2 \
    libfontconfig1 libfreetype6 libstdc++6 fonts-liberation \
    fonts-wqy-zenhei fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*
COPY --from=cached-browser /usr/bin/node /usr/bin/node
COPY --from=cached-browser /ms-playwright/chromium_headless_shell-1234 /ms-playwright/chromium_headless_shell-1234
COPY scripts/cloud/prepare-creator-browser-capsule.mjs /tmp/prepare-creator-browser-capsule.mjs
RUN node /tmp/prepare-creator-browser-capsule.mjs --extract-in-container \
    --output-dir /export/browser-capsule \
    --source-image "Ubuntu22 apt libraries; same-version CfT browser from cached worldkit image ${CACHED_BROWSER_IMAGE_ID}"

FROM scratch AS capsule-jammy-apt
COPY --from=jammy-source /export/browser-capsule /browser-capsule
