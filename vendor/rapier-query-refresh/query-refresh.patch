diff --git a/typescript/src.ts/geometry/narrow_phase.ts b/typescript/src.ts/geometry/narrow_phase.ts
index 6163053..1c976f4 100644
--- a/typescript/src.ts/geometry/narrow_phase.ts
+++ b/typescript/src.ts/geometry/narrow_phase.ts
@@ -43,0 +44,13 @@ export class NarrowPhase {
+    /** Copies actual solver normals, including compound contact clusters. */
+    public solverContactNormals(collider1: ColliderHandle, collider2: ColliderHandle): Vector[] {
+        const values = this.raw.solver_contact_normals(collider1, collider2);
+        const normals: Vector[] = [];
+        // #if DIM2
+        for (let i = 0; i < values.length; i += 2) normals.push(VectorOps.new(values[i], values[i + 1]));
+        // #endif
+        // #if DIM3
+        for (let i = 0; i < values.length; i += 3) normals.push(VectorOps.new(values[i], values[i + 1], values[i + 2]));
+        // #endif
+        return normals;
+    }
+
