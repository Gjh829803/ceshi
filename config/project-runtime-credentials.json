{
  "kind": "worldkit-project-runtime-credentials-manifest",
  "schemaVersion": 1,
  "runtimeRoot": ".codex-tmp/runtime-config",
  "projectLocalOnly": true,
  "allowEnvironmentCredentialOverrides": false,
  "files": [
    { "id": "lwdp", "path": ".codex-tmp/runtime-config/lwdp.env", "minimumBytes": 32 },
    { "id": "mg-seedance", "path": ".codex-tmp/runtime-config/mg.key", "minimumBytes": 20 },
    { "id": "mediakit", "path": ".codex-tmp/runtime-config/mediakit.key", "minimumBytes": 20 },
    { "id": "gemini-env", "path": ".codex-tmp/runtime-config/gemini.env", "minimumBytes": 64 },
    { "id": "google-service-account", "path": ".codex-tmp/runtime-config/google-service-account.json", "minimumBytes": 512 },
    { "id": "aws-credentials", "path": ".codex-tmp/runtime-config/aws-credentials", "minimumBytes": 64 },
    { "id": "aws-config", "path": ".codex-tmp/runtime-config/aws-config", "minimumBytes": 32 },
    { "id": "studio-public", "path": ".codex-tmp/runtime-config/studio-public.env", "minimumBytes": 32 }
  ]
}
