# Copy this file to .codex-tmp/runtime-config/gemini.env.
# Keep the service-account JSON in the same project-local ignored directory.
GOOGLE_APPLICATION_CREDENTIALS=.codex-tmp/runtime-config/google-service-account.json
GCLOUD_LOCATION=us-central1
WORLDKIT_GEMINI_PROMPT_LOCATION=global
WORLDKIT_GEMINI_IMAGE_LOCATION=global
WORLDKIT_GEMINI_PROMPT_MODEL=gemini-3-flash-preview
WORLDKIT_GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
WORLDKIT_GEMINI_EVENT_LOCATION=global
WORLDKIT_GEMINI_EVENT_MODEL=gemini-3.5-flash
WORLDKIT_IMAGEGEN_CONCURRENCY=6
