      "ownerId": "runtime-host",
      "code": "PROJECT_HEALTH_AUTHORITY_DUPLICATE",
      "left": {
        "selector": {
          "exactPaths": [],
          "pathPrefixes": ["packages/runtime-host"],
          "pathSuffixes": [],
          "packageIds": ["@whitebox-world/runtime-host"]
        },
        "symbolNames": ["canonicalSceneSource"]
      },
      "right": {
        "selector": {
          "exactPaths": [],
          "pathPrefixes": ["packages/native-babylon"],
          "pathSuffixes": [],
          "packageIds": ["@whitebox-world/native-babylon"]
        },
        "symbolNames": ["nativeSceneModule"]
      }
    },
    {
      "id": "public-protocol-single-parser-owner",
      "kind": "unique-public-symbol-owner",
      "ownerId": "public-contract",
      "code": "PROJECT_HEALTH_AUTHORITY_DUPLICATE",
      "selector": {
        "exactPaths": [],
        "pathPrefixes": ["packages"],
        "pathSuffixes": [],
        "packageIds": []
      },
      "symbolNames": ["parseCanonicalSceneExecutionPlanV1"],
