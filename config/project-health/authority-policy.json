    {
      "id": "public-compat-alias",
      "kind": "forbidden-public-symbol",
      "ownerId": "public-contract",
      "code": "PROJECT_HEALTH_PUBLIC_COMPAT_ALIAS",
      "selector": {
        "exactPaths": [],
        "pathPrefixes": ["packages"],
        "pathSuffixes": [],
        "packageIds": []
      },
      "symbolNames": [
        "hashValidationReportCompat",
        "legacyParseWorld",
        "parseAuthoringSpecV2",
        "parseAuthoringSpecV3"
      ]
