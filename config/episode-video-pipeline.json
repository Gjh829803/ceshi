{
  "kind": "worldkit-episode-video-pipeline",
  "schemaVersion": 2,
  "captureCount": 6,
  "seedanceCaptureIndices": [0, 1, 2, 3, 4, 5],
  "eventCaptureIndices": [0, 2, 4],
  "captureSeconds": 30,
  "promptTemplateVersion": "worldkit-reference-video-six-capture@6",
  "seedanceProvider": {
    "kind": "mg-seedance-2.5-plus-cf-upscale",
    "baseUrl": "https://clmm-mall.top/v1",
    "credentialFile": ".codex-tmp/runtime-config/mg.key",
    "submitPath": "/videos",
    "pollPathTemplate": "/videos/{taskId}",
    "pollIntervalSeconds": 15,
    "timeoutSeconds": 7200,
    "maxConcurrentJobs": 10,
    "maxTerminalAttempts": 3,
    "globalConcurrency": {
      "enabledInCloud": true,
      "namespace": "lwdp",
      "leaseNamePrefix": "worldkit-seedance-slot",
      "slotCount": 50,
      "leaseDurationSeconds": 900,
      "waitTimeoutSeconds": 21600,
      "pollIntervalSeconds": 5
    }
  },
  "referenceUpload": {
    "bucket": "leap-server-dev",
    "region": "us-east-1",
    "prefix": "codex-temp/worldkit-episode-video",
    "presignSeconds": 86400
  },
  "seedance": {
    "model": "mg-seedance-2.5-480p",
    "aspectRatio": "16:9",
    "resolution": "480p",
    "size": "854x480",
    "duration": 30,
    "seconds": "30",
    "generateAudio": true,
    "maxPromptChars": 15000,
    "includeAllStyledTriviews": true
  },
  "upscale": {
    "model": "cf-超分-720p-30s",
    "aspectRatio": "16:9",
    "resolution": "720p",
    "size": "1280x720",
    "duration": 30,
    "seconds": "1"
  },
  "delivery": {
    "width": 1280,
    "height": 720,
    "fps": 24,
    "frameCount": 720,
    "durationSeconds": 30,
    "requireAudio": true,
    "frameSynthesisAllowed": false
  }
}
