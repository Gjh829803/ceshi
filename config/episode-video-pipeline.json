{
  "kind": "worldkit-episode-video-pipeline",
  "schemaVersion": 2,
  "captureCount": 6,
  "seedanceCaptureIndices": [0, 1, 2, 3, 4, 5],
  "eventCaptureIndices": [0, 2, 4],
  "captureSeconds": 30,
  "promptTemplateVersion": "worldkit-reference-video-six-capture@6",
  "seedanceProvider": {
    "kind": "seedance-2.5-direct-api",
    "baseUrl": "https://env-00jy6ktfybhu.dev-hz.cloudbasefunction.cn/gateway",
    "credentialFile": ".codex-tmp/runtime-config/infinite-canvas.key",
    "modelsPath": "/v1/models",
    "uploadSignPath": "/v1/uploads/sign",
    "submitPath": "/v1/videos",
    "pollPathTemplate": "/v1/jobs/{taskId}",
    "pollIntervalSeconds": 8,
    "timeoutSeconds": 7200,
    "maxConcurrentJobs": 50,
    "maxTerminalAttempts": 1,
    "globalConcurrency": {
      "enabledInCloud": true,
      "namespace": "lwdp",
      "leaseNamePrefix": "worldkit-seedance25-api-slot",
      "slotCount": 50,
      "leaseDurationSeconds": 900,
      "waitTimeoutSeconds": 21600,
      "pollIntervalSeconds": 5
    }
  },
  "seedance": {
    "model": "seedance-2.5",
    "ratio": "16:9",
    "resolution": "720p",
    "size": "1280x720",
    "duration": 30,
    "generateAudio": true,
    "maxPromptChars": 15000,
    "includeAllStyledTriviews": true
  },
  "fallback": {
    "pipelineConfigPath": "config/episode-video-pipeline-mg-fallback.json",
    "triggerTerminalStatuses": ["failed", "refunded"],
    "preservePrimaryJournal": true
  },
  "delivery": {
    "width": 1280,
    "height": 720,
    "fps": 24,
    "frameCount": 720,
    "durationSeconds": 30,
    "requireAudio": true,
    "frameSynthesisAllowed": false
  }
}
