{
  "kind": "worldkit-cloud-episode-production-config",
  "schemaVersion": 2,
  "enabled": true,
  "executionProfile": "cpu-gpu-batch-cpu@1",
  "workerImage": "829115578968.dkr.ecr.us-east-2.amazonaws.com/worldkit-cloud-worker@sha256:4c3ca93532f000ddf03b2e63fcb03715f2f9991caf4b1f608e4b9f4d34bcd469",
  "outputS3Root": "s3://leap-world-us-east-2/world-model/platform/agent-whitebox-world-sdk/cloud-episodes",
  "namespace": "lwdp",
  "gpuResourceName": "nvidia.com/gpu",
  "gpuCount": 1,
  "gpuBatch": {
    "queueS3Prefix": "s3://leap-world-us-east-2/world-model/platform/agent-whitebox-world-sdk/gpu-capture-queue",
    "minimumBatchSize": 100,
    "maximumBatchSize": 128,
    "tailFlushIdleSeconds": 120,
    "taskLeaseSeconds": 3600,
    "dispatcherIntervalSeconds": 60,
    "ephemeralStorageRequest": "32Gi",
    "ephemeralStorageLimit": "64Gi"
  },
  "cpuWorker": {
    "cpuRequest": "2",
    "cpuLimit": "8",
    "memoryRequest": "4Gi",
    "memoryLimit": "16Gi",
    "ephemeralStorageRequest": "16Gi",
    "ephemeralStorageLimit": "32Gi"
  },
  "nodeSelector": {},
  "tolerations": [
    {
      "key": "nvidia.com/gpu",
      "operator": "Equal",
      "value": "true",
      "effect": "NoSchedule"
    },
    {
      "key": "ray.io/node-type",
      "operator": "Equal",
      "value": "gpu-worker",
      "effect": "NoSchedule"
    }
  ]
}
