{
  "kind": "worldkit-cloud-episode-production-config",
  "schemaVersion": 2,
  "enabled": true,
  "executionProfile": "cpu-gpu-streaming-checkpoints@1",
  "workerImage": "829115578968.dkr.ecr.us-east-2.amazonaws.com/worldkit-cloud-worker@sha256:f724a09268c448f4f708366441e6a9ebaf50f01b66ddd3850290f22559f3b10d",
  "postprocessWorkerImage": "829115578968.dkr.ecr.us-east-2.amazonaws.com/worldkit-cloud-postprocess@sha256:75b1ea2f49e9c9096717364b0591f32acac4146da576a259acadc6eecb258653",
  "outputS3Root": "s3://leap-world-us-east-2/world-model/platform/agent-whitebox-world-sdk/cloud-episodes",
  "namespace": "lwdp",
  "gpuResourceName": "nvidia.com/gpu",
  "gpuCount": 1,
  "gpuBatch": {
    "queueS3Prefix": "s3://leap-world-us-east-2/world-model/platform/agent-whitebox-world-sdk/gpu-capture-queue",
    "minimumBatchSize": 100,
    "maximumBatchSize": 128,
    "tailFlushIdleSeconds": 120,
    "taskLeaseSeconds": 3600,
    "dispatcherIntervalSeconds": 60,
    "caseConcurrency": 16,
    "dispatchReadyImmediately": true,
    "ephemeralStorageRequest": "32Gi",
    "ephemeralStorageLimit": "64Gi"
  },
  "cpuWorker": {
    "cpuRequest": "2",
    "cpuLimit": "8",
    "memoryRequest": "4Gi",
    "memoryLimit": "16Gi",
    "ephemeralStorageRequest": "16Gi",
    "ephemeralStorageLimit": "32Gi",
    "nodeSelector": {
      "workload-type": "ray-cpu"
    },
    "tolerations": [
      {
        "key": "ray.io/node-type",
        "operator": "Equal",
        "value": "worker",
        "effect": "NoSchedule"
      }
    ]
  },
  "nodeSelector": {},
  "tolerations": [
    {
      "key": "nvidia.com/gpu",
      "operator": "Equal",
      "value": "true",
      "effect": "NoSchedule"
    },
    {
      "key": "ray.io/node-type",
      "operator": "Equal",
      "value": "gpu-worker",
      "effect": "NoSchedule"
    }
  ]
}
