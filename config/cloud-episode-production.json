{
  "kind": "worldkit-cloud-episode-production-config",
  "schemaVersion": 2,
  "enabled": true,
  "executionProfile": "cpu-gpu-streaming-checkpoints@1",
  "workerImage": "829115578968.dkr.ecr.us-east-2.amazonaws.com/worldkit-cloud-worker@sha256:f267bb928a2b11f1164d2a1c83a44687e25b0a119f4baec9477a789c3045a420",
  "postprocessWorkerImage": "829115578968.dkr.ecr.us-east-2.amazonaws.com/worldkit-cloud-worker@sha256:f267bb928a2b11f1164d2a1c83a44687e25b0a119f4baec9477a789c3045a420",
  "outputS3Root": "s3://leap-world-us-east-2/world-model/platform/agent-whitebox-world-sdk/cloud-episodes",
  "namespace": "lwdp",
  "gpuResourceName": "nvidia.com/gpu",
  "gpuCount": 1,
  "gpuBatch": {
    "queueS3Prefix": "s3://leap-world-us-east-2/world-model/platform/agent-whitebox-world-sdk/gpu-capture-queue",
    "minimumBatchSize": 100,
    "maximumBatchSize": 128,
    "tailFlushIdleSeconds": 120,
    "taskLeaseSeconds": 3600,
    "dispatcherIntervalSeconds": 60,
    "caseConcurrency": 16,
    "dispatchReadyImmediately": true,
    "ephemeralStorageRequest": "32Gi",
    "ephemeralStorageLimit": "64Gi"
  },
  "cpuWorker": {
    "cpuRequest": "2",
    "cpuLimit": "8",
    "memoryRequest": "4Gi",
    "memoryLimit": "16Gi",
    "ephemeralStorageRequest": "16Gi",
    "ephemeralStorageLimit": "32Gi",
    "nodeSelector": {
      "workload-type": "ray-cpu"
    },
    "tolerations": [
      {
        "key": "ray.io/node-type",
        "operator": "Equal",
        "value": "worker",
        "effect": "NoSchedule"
      }
    ]
  },
  "nodeSelector": {},
  "tolerations": [
    {
      "key": "nvidia.com/gpu",
      "operator": "Equal",
      "value": "true",
      "effect": "NoSchedule"
    },
    {
      "key": "ray.io/node-type",
      "operator": "Equal",
      "value": "gpu-worker",
      "effect": "NoSchedule"
    }
  ]
}
