{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "en": {
      "type": "string",
      "minLength": 1
    },
    "archetype": {
      "type": "string",
      "minLength": 1
    },
    "visualVariant": {
      "type": "string",
      "minLength": 1
    },
    "radius": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "seat": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "envelope": {
      "oneOf": [
        {
          "$ref": "#/$defs/box"
        },
        {
          "$ref": "#/$defs/capsule"
        }
      ]
    },
    "wheelbaseMeters": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "rearAxleZMeters": {
      "type": "number"
    },
    "wheelPhysics": {
      "type": "object",
      "properties": {
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "halfWheelbase": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "wheelWidth": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "hubHeight": {
          "type": "number",
          "minimum": 0
        },
        "halfTrack": {
          "type": "number",
          "minimum": 0
        },
        "chassis": {
          "$ref": "#/$defs/box"
        },
        "cabin": {
          "$ref": "#/$defs/box"
        },
        "bodyParts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/box"
          }
        },
        "wheels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "z": {
                "type": "number"
              },
              "driven": {
                "type": "boolean"
              },
              "steering": {
                "type": "boolean"
              }
            },
            "required": [
              "x",
              "z",
              "driven",
              "steering"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "flyingCreatureCollision": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/probe"
      }
    },
    "flyingCreatureGround": {
      "type": "object",
      "properties": {
        "rootHeight": {
          "type": "number"
        },
        "seat": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "probes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/probe"
          }
        },
        "support": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "additionalProperties": false
    },
    "bodyPhysics": {
      "type": "object",
      "properties": {
        "water": {
          "type": "object",
          "properties": {
            "depth": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "bottom": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "spaceFlight": {
      "type": "object",
      "properties": {
        "hull": {
          "enum": [
            "box",
            "disc"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Whitebox physical content parameters",
  "description": "Distances and radii are metres; positions are local XYZ coordinates. Fields are optional until required by the consuming capability.",
  "$defs": {
    "box": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "box"
        },
        "halfExtents": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minItems": 3,
          "maxItems": 3
        },
        "offset": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": [
        "kind",
        "halfExtents",
        "offset"
      ],
      "additionalProperties": false
    },
    "capsule": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "capsule"
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "halfHeight": {
          "type": "number",
          "minimum": 0
        },
        "offset": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": [
        "kind",
        "radius",
        "halfHeight",
        "offset"
      ],
      "additionalProperties": false
    },
    "probe": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "center": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "id",
        "center",
        "radius"
      ],
      "additionalProperties": false
    }
  },
  "$id": "urn:worldkit:content-parameters:1"
}
