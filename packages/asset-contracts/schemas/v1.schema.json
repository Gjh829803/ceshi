{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:worldkit:asset-contracts:1.0.0",
  "$defs": {
    "AssetRef": {
      "type": "object",
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,127}$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      },
      "required": [
        "asset_id",
        "version"
      ],
      "additionalProperties": false
    },
    "AssetRequest": {
      "type": "object",
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,127}$"
        },
        "version": {
          "type": "string",
          "pattern": "^(latest|[~^]?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*))$"
        }
      },
      "required": [
        "asset_id",
        "version"
      ],
      "additionalProperties": false
    },
    "Requirement": {
      "type": "object",
      "properties": {
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      },
      "required": [
        "contract_id",
        "version"
      ],
      "additionalProperties": false
    },
    "RuntimeContext": {
      "type": "object",
      "properties": {
        "runtime_id": {
          "type": "string",
          "minLength": 1
        },
        "runtime_version": {
          "type": "string",
          "minLength": 1
        },
        "adapter_id": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "preset_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "overrides_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "supported_contracts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Requirement"
          }
        },
        "runtime_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "preset_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "preset_id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
              },
              "digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "preset_id",
              "version",
              "digest"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "runtime_id",
        "runtime_version",
        "adapter_id",
        "adapter_version",
        "preset_digest",
        "overrides_digest",
        "supported_contracts"
      ],
      "additionalProperties": false
    },
    "Artifact": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        },
        "mime_type": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "runtime",
            "preview"
          ]
        },
        "storage_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:%?#\\u0000])(?!.*//).+$"
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "byte_length",
        "mime_type",
        "format",
        "role",
        "storage_path"
      ],
      "additionalProperties": false
    },
    "Resource": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        },
        "mime_type": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "runtime",
            "preview"
          ]
        },
        "storage_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:%?#\\u0000])(?!.*//).+$"
        },
        "resource_id": {
          "type": "string",
          "minLength": 1
        },
        "logical_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:%?#\\u0000])(?!.*//).+$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "byte_length",
        "mime_type",
        "format",
        "role",
        "storage_path",
        "resource_id",
        "logical_paths"
      ],
      "additionalProperties": false
    },
    "ManifestRef": {
      "type": "object",
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,127}$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "manifest_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "manifest_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:%?#\\u0000])(?!.*//).+$"
        }
      },
      "required": [
        "asset_id",
        "version",
        "manifest_digest",
        "manifest_path"
      ],
      "additionalProperties": false
    },
    "Manifest": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "asset-manifest"
        },
        "contract_version": {
          "const": "1.0.0"
        },
        "asset_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,127}$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "taxonomy_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "group": {
          "type": "string",
          "minLength": 1
        },
        "placeholder": {
          "type": "boolean"
        },
        "model_resource_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "preview_resource_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Resource"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssetRef"
          }
        },
        "runtime_requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Requirement"
          }
        },
        "sections": {
          "type": "object",
          "properties": {
            "asset": {
              "type": "object"
            },
            "capabilities": {
              "type": "object"
            },
            "bindings": {
              "type": "object"
            },
            "facts": {
              "type": "object"
            },
            "animations": {
              "type": "array",
              "items": {}
            },
            "provenance": {
              "type": "object"
            },
            "validation": {
              "$ref": "#/$defs/RuntimeValidation"
            },
            "assembly": {
              "type": "object"
            }
          },
          "required": [
            "asset",
            "capabilities",
            "bindings",
            "facts",
            "animations",
            "provenance",
            "validation",
            "assembly"
          ],
          "additionalProperties": false
        },
        "extensions": {
          "type": "object",
          "properties": {
            "whitebox": {
              "type": "object"
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "contract_version",
        "asset_id",
        "version",
        "taxonomy_version",
        "display_name",
        "description",
        "group",
        "placeholder",
        "model_resource_id",
        "preview_resource_id",
        "resources",
        "dependencies",
        "runtime_requirements",
        "sections",
        "extensions"
      ],
      "additionalProperties": false
    },
    "Summary": {
      "type": "object",
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,127}$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "manifest_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "manifest_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:%?#\\u0000])(?!.*//).+$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "group": {
          "type": "string",
          "minLength": 1
        },
        "placeholder": {
          "type": "boolean"
        },
        "preview": {
          "anyOf": [
            {
              "$ref": "#/$defs/Artifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "morphology": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "movement": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "readiness": {
          "type": "object",
          "properties": {
            "previewable": {
              "type": "boolean"
            },
            "runtime": {
              "enum": [
                "unknown",
                "verified",
                "incompatible",
                "adapter_required"
              ]
            }
          },
          "required": [
            "previewable",
            "runtime"
          ],
          "additionalProperties": false
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Requirement"
          }
        },
        "stage": {
          "type": "string"
        },
        "license_status": {
          "type": "string"
        },
        "license_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "asset_id",
        "version",
        "manifest_digest",
        "manifest_path",
        "display_name",
        "description",
        "group",
        "placeholder",
        "preview",
        "morphology",
        "movement",
        "capabilities",
        "readiness",
        "requirements",
        "stage",
        "license_status",
        "license_id"
      ],
      "additionalProperties": false
    },
    "Registry": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "asset-registry"
        },
        "contract_version": {
          "const": "1.0.0"
        },
        "registry_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,127}$"
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "taxonomy_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "audience": {
          "enum": [
            "internal",
            "public"
          ]
        },
        "index_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:%?#\\u0000])(?!.*//).+$"
        },
        "index_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "endpoints": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:%?#\\u0000])(?!.*//).+$"
            },
            "describe": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:%?#\\u0000])(?!.*//).+$"
            },
            "compatibility": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:%?#\\u0000])(?!.*//).+$"
            },
            "resolve": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:%?#\\u0000])(?!.*//).+$"
            },
            "artifacts": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:%?#\\u0000])(?!.*//).+$"
            },
            "resource_scope": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:%?#\\u0000])(?!.*//).+$"
            }
          },
          "required": [
            "search",
            "describe",
            "compatibility",
            "resolve",
            "artifacts"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "contract_version",
        "registry_id",
        "snapshot_id",
        "taxonomy_version",
        "audience",
        "index_path",
        "index_digest",
        "endpoints"
      ],
      "additionalProperties": false
    },
    "SearchRequest": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string"
        },
        "asset_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,127}$"
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "group": {
          "type": "string",
          "minLength": 1
        },
        "morphology": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "movement": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stage": {
          "type": "string"
        },
        "previewable": {
          "type": "boolean"
        },
        "runtime_ready": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "cursor": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "runtime": {
          "$ref": "#/$defs/RuntimeContext"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "SearchResponse": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "registry_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,127}$"
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Summary"
          },
          "maxItems": 20
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "contract_version",
        "registry_id",
        "snapshot_id",
        "items",
        "next_cursor"
      ],
      "additionalProperties": false
    },
    "CompatibilityRequest": {
      "type": "object",
      "properties": {
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssetRef"
          },
          "minItems": 1,
          "maxItems": 100
        },
        "runtime": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeContext"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "assets",
        "runtime"
      ],
      "additionalProperties": false
    },
    "CompatibilityResult": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "status": {
          "enum": [
            "compatible",
            "incompatible",
            "unknown",
            "adapter_required"
          ]
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssetRef"
          }
        },
        "runtime": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeContext"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string"
              },
              "asset_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._-]{0,127}$"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "asset_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._-]{0,127}$"
              },
              "version": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
              },
              "manifest_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "evidence_id": {
                "type": "string",
                "minLength": 1
              },
              "runtime_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "adapter_version": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
              },
              "preset_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "asset_id",
              "version",
              "manifest_digest",
              "evidence_id",
              "runtime_digest",
              "adapter_version",
              "preset_digest"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "contract_version",
        "status",
        "assets",
        "runtime",
        "reasons",
        "evidence"
      ],
      "additionalProperties": false
    },
    "ResolveRequest": {
      "type": "object",
      "properties": {
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssetRequest"
          },
          "maxItems": 100
        },
        "purpose": {
          "enum": [
            "runtime",
            "preview"
          ]
        },
        "runtime": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeContext"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "assemblies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssemblyRef"
          },
          "maxItems": 50
        }
      },
      "required": [
        "assets",
        "purpose",
        "runtime"
      ],
      "additionalProperties": false
    },
    "ProjectLock": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "asset-lock"
        },
        "contract_version": {
          "const": "1.0.0"
        },
        "registry_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,127}$"
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "taxonomy_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "purpose": {
          "enum": [
            "runtime",
            "preview"
          ]
        },
        "roots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssetRef"
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ManifestRef"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Artifact"
          }
        },
        "assemblies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "assembly_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._-]{0,127}$"
              },
              "version": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
              },
              "manifest_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "assembly_id",
              "version",
              "manifest_digest"
            ],
            "additionalProperties": false
          }
        },
        "runtime": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeContext"
            },
            {
              "type": "null"
            }
          ]
        },
        "compatibility": {
          "$ref": "#/$defs/CompatibilityResult"
        },
        "lock_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "kind",
        "contract_version",
        "registry_id",
        "snapshot_id",
        "taxonomy_version",
        "purpose",
        "roots",
        "assets",
        "artifacts",
        "assemblies",
        "runtime",
        "compatibility",
        "lock_digest"
      ],
      "additionalProperties": false
    },
    "ArtifactLocation": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "contract_version",
        "artifact_id",
        "url",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "message",
            "retryable",
            "details"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    },
    "AssemblyRef": {
      "type": "object",
      "properties": {
        "assembly_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,127}$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      },
      "required": [
        "assembly_id",
        "version"
      ],
      "additionalProperties": false
    },
    "ResourceScopeRequest": {
      "type": "object",
      "properties": {
        "allowed_asset_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,127}$"
          },
          "uniqueItems": true,
          "maxItems": 1000
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "allowed_asset_ids"
      ],
      "additionalProperties": false
    },
    "ResourceScope": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "registry_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,127}$"
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "denied_resource_sha256": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "uniqueItems": true
        },
        "scope_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "contract_version",
        "registry_id",
        "snapshot_id",
        "denied_resource_sha256",
        "scope_digest"
      ],
      "additionalProperties": false
    },
    "RuntimeEvidence": {
      "type": "object",
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,127}$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "runtime_id": {
          "type": "string",
          "minLength": 1
        },
        "runtime_version": {
          "type": "string",
          "minLength": 1
        },
        "adapter_id": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "preset_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "overrides_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "runtime_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "preset_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "preset_id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
              },
              "digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "preset_id",
              "version",
              "digest"
            ],
            "additionalProperties": false
          }
        },
        "status": {
          "const": "verified"
        },
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "supported_contracts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Requirement"
          }
        }
      },
      "required": [
        "asset_id",
        "version",
        "status",
        "evidence_id",
        "runtime_id",
        "runtime_version",
        "runtime_digest",
        "adapter_id",
        "adapter_version",
        "preset_digest",
        "overrides_digest"
      ],
      "additionalProperties": false
    },
    "RuntimeValidation": {
      "type": "object",
      "properties": {
        "runtime": {
          "enum": [
            "not_run",
            "failed",
            "verified",
            "incompatible"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "$ref": "#/$defs/RuntimeEvidence"
              }
            ]
          }
        }
      },
      "required": [
        "runtime",
        "evidence"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "runtime": {
                "const": "verified"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "contains": {
                  "$ref": "#/$defs/RuntimeEvidence"
                }
              }
            }
          }
        }
      ],
      "additionalProperties": true
    }
  }
}
