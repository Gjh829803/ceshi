{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "worldkit://schema/authoring-spec@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "id", "seed", "world", "resources", "nodes", "relationships", "rules", "startup", "constraints"],
  "properties": {
    "kind": { "const": "worldkit-authoring-spec" },
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "provenance": { "$ref": "#/$defs/provenance" },
    "world": { "$ref": "#/$defs/world" },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prototypes"],
      "properties": {
        "prototypes": { "type": "array", "items": { "$ref": "#/$defs/prototype" } }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 4,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/terrainNode" },
          { "$ref": "#/$defs/waterNode" },
          { "$ref": "#/$defs/objectNode" },
          { "$ref": "#/$defs/subjectNode" },
          { "$ref": "#/$defs/cameraNode" },
          { "$ref": "#/$defs/anchorNode" }
        ]
      }
    },
    "relationships": { "type": "array", "items": { "$ref": "#/$defs/relationship" } },
    "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
    "startup": { "$ref": "#/$defs/startup" },
    "constraints": { "type": "object", "additionalProperties": false }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$" },
    "resourceRef": { "type": "string", "format": "worldkit-resource-ref" },
    "finiteNumber": { "type": "number" },
    "positiveNumber": { "type": "number", "exclusiveMinimum": 0 },
    "vec2": {
      "type": "array",
      "prefixItems": [{ "$ref": "#/$defs/finiteNumber" }, { "$ref": "#/$defs/finiteNumber" }],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "positiveVec2": {
      "type": "array",
      "prefixItems": [{ "$ref": "#/$defs/positiveNumber" }, { "$ref": "#/$defs/positiveNumber" }],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "vec3": {
      "type": "array",
      "prefixItems": [{ "$ref": "#/$defs/finiteNumber" }, { "$ref": "#/$defs/finiteNumber" }, { "$ref": "#/$defs/finiteNumber" }],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "positiveVec3": {
      "type": "array",
      "prefixItems": [{ "$ref": "#/$defs/positiveNumber" }, { "$ref": "#/$defs/positiveNumber" }, { "$ref": "#/$defs/positiveNumber" }],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classId"],
      "properties": { "classId": { "type": "string", "minLength": 1, "maxLength": 128 } }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positionMeters"],
      "properties": {
        "positionMeters": { "$ref": "#/$defs/vec3" },
        "rotationEulerRadiansXYZ": { "$ref": "#/$defs/vec3" },
        "scaleXYZ": { "$ref": "#/$defs/positiveVec3" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "userPrompt": { "type": "string", "maxLength": 20000 },
        "referenceImages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["assetRef", "evidenceClass"],
            "properties": {
              "assetRef": { "$ref": "#/$defs/resourceRef" },
              "evidenceClass": { "enum": ["user-explicit", "reference-visible", "planner-inferred"] }
            }
          }
        }
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinateSystem", "bounds", "gravityMetersPerSecondSquaredXYZ", "environment", "resourceBudget"],
      "properties": {
        "coordinateSystem": { "const": "right-handed-y-up-minus-z-forward" },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["centerXZ", "sizeXZ", "heightRangeMeters"],
          "properties": {
            "centerXZ": { "$ref": "#/$defs/vec2" },
            "sizeXZ": { "$ref": "#/$defs/positiveVec2" },
            "heightRangeMeters": {
              "type": "array",
              "prefixItems": [{ "$ref": "#/$defs/finiteNumber" }, { "$ref": "#/$defs/finiteNumber" }],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "gravityMetersPerSecondSquaredXYZ": { "$ref": "#/$defs/vec3" },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["preset"],
          "properties": { "preset": { "enum": ["clear-day", "golden-hour", "overcast", "night"] } }
        },
        "resourceBudget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxVertices", "maxTriangles", "maxColliders"],
          "properties": {
            "maxVertices": { "type": "integer", "minimum": 1 },
            "maxTriangles": { "type": "integer", "minimum": 1 },
            "maxColliders": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "prototype": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "kind", "primitive", "collisionEnabled"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "const": 1 },
        "kind": { "const": "primitive" },
        "primitive": { "enum": ["box", "sphere", "cylinder", "cone"] },
        "sizeMetersXYZ": { "$ref": "#/$defs/positiveVec3" },
        "radiusMeters": { "$ref": "#/$defs/positiveNumber" },
        "heightMeters": { "$ref": "#/$defs/positiveNumber" },
        "collisionEnabled": { "type": "boolean" },
        "semantic": { "$ref": "#/$defs/semantic" }
      },
      "allOf": [
        { "if": { "properties": { "primitive": { "const": "box" } } }, "then": { "properties": { "sizeMetersXYZ": true }, "required": ["sizeMetersXYZ"] } },
        { "if": { "properties": { "primitive": { "const": "sphere" } } }, "then": { "properties": { "radiusMeters": true }, "required": ["radiusMeters"] } },
        { "if": { "properties": { "primitive": { "enum": ["cylinder", "cone"] } } }, "then": { "properties": { "radiusMeters": true, "heightMeters": true }, "required": ["radiusMeters", "heightMeters"] } }
      ]
    },
    "proceduralSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "relief"],
      "properties": {
        "kind": { "const": "procedural" },
        "relief": { "enum": ["flat", "plain", "hills", "mountains"] },
        "baseHeightMeters": { "$ref": "#/$defs/finiteNumber" },
        "amplitudeMeters": { "type": "number", "minimum": 0 },
        "frequencyPerMeter": { "$ref": "#/$defs/positiveNumber" },
        "octaves": { "type": "integer", "minimum": 1, "maximum": 8 },
        "lacunarityRatio": { "$ref": "#/$defs/positiveNumber" },
        "persistenceRatio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "terrainNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "components"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "terrain" },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": ["terrain"],
          "properties": {
            "terrain": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "grid"],
              "properties": {
                "source": { "$ref": "#/$defs/proceduralSource" },
                "grid": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["centerXZ", "sizeXZ", "resolutionXZ"],
                  "properties": {
                    "centerXZ": { "$ref": "#/$defs/vec2" },
                    "sizeXZ": { "$ref": "#/$defs/positiveVec2" },
                    "resolutionXZ": {
                      "type": "array",
                      "prefixItems": [
                        { "type": "integer", "minimum": 2, "maximum": 1025 },
                        { "type": "integer", "minimum": 2, "maximum": 1025 }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2
                    }
                  }
                },
                "semantic": { "$ref": "#/$defs/semantic" }
              }
            }
          }
        }
      }
    },
    "waterBoundary": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "centerXZ", "radiusMeters"],
          "properties": { "kind": { "const": "circle" }, "centerXZ": { "$ref": "#/$defs/vec2" }, "radiusMeters": { "$ref": "#/$defs/positiveNumber" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "centerXZ", "radiusMetersXZ"],
          "properties": { "kind": { "const": "ellipse" }, "centerXZ": { "$ref": "#/$defs/vec2" }, "radiusMetersXZ": { "$ref": "#/$defs/positiveVec2" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "pointsXZ"],
          "properties": { "kind": { "const": "polygon" }, "pointsXZ": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/vec2" } } }
        }
      ]
    },
    "waterNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "components"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "water" },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": ["water"],
          "properties": {
            "water": {
              "type": "object",
              "additionalProperties": false,
              "required": ["terrainEntityId", "boundary", "depthMeters"],
              "properties": {
                "terrainEntityId": { "$ref": "#/$defs/id" },
                "boundary": { "$ref": "#/$defs/waterBoundary" },
                "depthMeters": { "$ref": "#/$defs/positiveNumber" },
                "shoreWidthMeters": { "type": "number", "minimum": 0 },
                "waterLevelMeters": { "$ref": "#/$defs/finiteNumber" },
                "traversalMode": { "enum": ["blocked", "swimmable", "walkable"] },
                "semantic": { "$ref": "#/$defs/semantic" }
              }
            }
          }
        }
      }
    },
    "objectNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "prototypeRef", "transform"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "object" },
        "prototypeRef": { "$ref": "#/$defs/resourceRef" },
        "transform": { "$ref": "#/$defs/transform" }
      }
    },
    "subjectNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "kitRef"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "subject" },
        "kitRef": { "$ref": "#/$defs/resourceRef" }
      }
    },
    "cameraNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "components"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "camera" },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cameraRig"],
          "properties": {
            "cameraRig": {
              "type": "object",
              "additionalProperties": false,
              "required": ["defaultRigRef", "allowedRigRefs", "target", "thirdPerson", "manualSwitchAllowed"],
              "properties": {
                "defaultRigRef": { "$ref": "#/$defs/resourceRef" },
                "allowedRigRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/resourceRef" } },
                "target": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["entityId"],
                  "properties": { "entityId": { "$ref": "#/$defs/id" }, "targetHeightMeters": { "$ref": "#/$defs/finiteNumber" } }
                },
                "thirdPerson": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["pitchRadians", "distanceMeters", "targetHeightMeters", "fovDegrees"],
                  "properties": {
                    "pitchRadians": { "type": "number", "minimum": -0.95, "maximum": 0.65 },
                    "distanceMeters": { "type": "number", "minimum": 1.8, "maximum": 8 },
                    "targetHeightMeters": { "type": "number", "minimum": 0.5, "maximum": 4.5 },
                    "fovDegrees": { "type": "number", "minimum": 35, "maximum": 90 }
                  }
                },
                "manualSwitchAllowed": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "anchorNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "transform", "semantic"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "anchor" },
        "transform": { "$ref": "#/$defs/transform" },
        "semantic": { "$ref": "#/$defs/semantic" }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "schemaVersion"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "type": "string", "minLength": 1 }, "schemaVersion": { "const": 1 } }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "type": "string", "minLength": 1 } }
    },
    "startup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spawnAnchorId", "controlledEntityId", "cameraEntityId"],
      "properties": {
        "spawnAnchorId": { "$ref": "#/$defs/id" },
        "controlledEntityId": { "$ref": "#/$defs/id" },
        "cameraEntityId": { "$ref": "#/$defs/id" }
      }
    }
  }
}
